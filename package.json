{
  "name": "calc-key",
  "version": "1.0.0",
  "description": "Calculator key font helper",
  "main": "./dist/kfh.cjs",
  "module": "./dist/kfh.mjs",
  "browser": "./dist/kfh.js",
  "exports": {
    ".": {
      "import": "./dist/kfh.mjs",
      "require": "./dist/kfh.cjs"
    },
    "./dist/kfh.js": "./dist/kfh.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/kfh.js",
    "dist/kfh.cjs",
    "dist/kfh.mjs",
    "dist/*.LICENSE.txt",
    "src/index.js",
    "src/config/",
    "webpack.config.cjs"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "webpack --mode=production --node-env=production",
    "build:lib": "webpack --env library --mode=production --node-env=production",
    "prepack": "npm run build:lib",
    "serve": "webpack serve",
    "dev": "wrangler dev --ip=0.0.0.0 --port=8791"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalcWorld/KeyFontHelper.git"
  },
  "homepage": "https://github.com/CalcWorld/KeyFontHelper#readme",
  "bugs": {
    "url": "https://github.com/CalcWorld/KeyFontHelper/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["calculator", "casio", "classwiz", "key", "font"],
  "author": "CalcWorld",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@babel/core": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@webpack-cli/generators": "^3.0.7",
    "babel-loader": "^9.2.1",
    "html-webpack-plugin": "^5.5.0",
    "webpack": "5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "wrangler": "4.131.1",
    "mwbot": "^2.1.3"
  }
}
